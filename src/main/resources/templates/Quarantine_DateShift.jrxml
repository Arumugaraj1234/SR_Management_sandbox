	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="NO_DATA_ADAPTER"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w1" value="405"/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w2" value="584"/>
	<parameter name="Q_HDR_ID" class="java.lang.String"/>
	<parameter name="TENANT_ID" class="java.lang.String"/>
	<parameter name="LOGO" class="java.awt.Image"/>
	<queryString>
		<![CDATA[SELECT 
    hdr.qu_hdr_id AS Q_HDR_ID,
    hdr.Issue_details AS ISSUE_DETAILS,
    DATE_FORMAT(hdr.SHIFT_DATE,'%d-%b-%y') AS SHIFTDATE,
    hdr.ica_method_no AS ICA_METHOD_NO,
    hdr.ica_certified AS ICA_CERTIFIED,
    dtl.product_code AS PRODUCT_CODE,
    dtl.serial_no AS SERIAL_NO,
    dtl.is_verified AS IS_VERIFIED,
    smtype.SHIFT_MST_TYPE_DESCRIPTION AS SHIFT
FROM
    quarentine_report_hdr hdr,
    quarentine_report_dtl dtl,
    shift_mst_hdr shdr,
    shift_mst_type_code smtype
WHERE
    hdr.qu_hdr_id = dtl.qu_hdr_id
        AND hdr.shift = shdr.SHIFT_MST_HDR_ID
        AND shdr.SHIFT_MST_TYPE_CODE = smtype.SHIFT_MST_TYPE_CODE
        AND hdr.qu_hdr_id = $P{Q_HDR_ID}
        AND hdr.tenant_id = $P{TENANT_ID}]]>
	</queryString>
