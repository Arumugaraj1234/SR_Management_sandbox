	<queryString language="SQL">
		<![CDATA[SELECT 
    hdr.TRACE_CHILD_PART_HDR_ID AS TRACE_CHILD_PART_HDR_ID,
    hdr.LINE_CODE AS LINE_CODE,
    hdr.PRODUCT_CODE AS PRODUCT_CODE,
    hdr.WORKORDER_ID AS WORKORDER_ID,
    hdr.SERIAL_NUMBER AS SERIAL_NUMBER,
    hdr.TRANSACTION_NO AS TRANSACTION_NO,
    hdr.CREATED_ON AS CREATED_ON,
    hdr.SHIFT_DATE AS SHIFT_DATE,
    dtl.CHILD_PRODUCT_CODE AS CHILD_PRODUCT_CODE,
    dtl.LOT_NUMBER AS LOT_NUMBER,
    dtl.ISSUED_DATE As ISSUED_DATE,
    dtl.ISSUED_TIME As ISSUED_TIME,
    dtl.ASSEMBLED_DATETIME As ASSEMBLED_DATETIME,
    dtl.STORAGE_UNIT_NUMBER AS STORAGE_UNIT_NUMBER,
    pm.PRODUCT_DESCRIPTION AS HDR_PRODUCT_DESCRIPTION,
    cm.PRODUCT_DESCRIPTION AS CHILD_PRODUCT_DESCRIPTION,
    smtype.SHIFT_MST_TYPE_DESCRIPTION AS SHIFT,
    lmst.LINE_MST_DESCRIPTION As LINE_MST_DESCRIPTION
FROM
    trace_child_part_hdr hdr,
    trace_child_part_dtl dtl,
    product_mst pm,
    product_mst cm,
    shift_mst_hdr shdr,
    shift_mst_type_code smtype,
    line_mst lmst
    
WHERE
    hdr.TRACE_CHILD_PART_HDR_ID = dtl.TRACE_CHILD_PART_HDR_ID
        AND hdr.PRODUCT_CODE = pm.PRODUCT_CODE
        AND hdr.LINE_CODE = lmst.LINE_MST_CODE
        AND dtl.CHILD_PRODUCT_CODE = cm.PRODUCT_CODE
        AND hdr.SHIFT = shdr.SHIFT_MST_HDR_ID
        AND shdr.SHIFT_MST_TYPE_CODE = smtype.SHIFT_MST_TYPE_CODE
        AND hdr.SERIAL_NUMBER = $P{SERIAL_NUMBER}
        AND hdr.TENANT_ID = $P{TENANT_ID}]]>
	</queryString>
