<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="EVM_TRACEABILITY_REPORT" pageWidth="832" pageHeight="1040" columnWidth="792" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="fed96766-910d-40af-90a1-b5d2da59a1eb">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="140_ADAPTER"/>
	<parameter name="SERIAL_NUMBER" class="java.lang.String"/>
	<parameter name="TENANT_ID" class="java.lang.String"/>
	<parameter name="LOGO" class="java.awt.Image"/>
	<parameter name="LINE_CODE" class="java.lang.String"/>
	<parameter name="LINE_DESC" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[SELECT 
    hdr.TRACE_CHILD_PART_HDR_ID AS TRACE_CHILD_PART_HDR_ID,
    hdr.LINE_CODE AS LINE_CODE,
    hdr.PRODUCT_CODE AS PRODUCT_CODE,
    hdr.WORKORDER_ID AS WORKORDER_ID,
    hdr.SERIAL_NUMBER AS SERIAL_NUMBER,
    hdr.TRANSACTION_NO AS TRANSACTION_NO,
    hdr.CREATED_ON AS CREATED_ON,
    DATE_FORMAT(hdr.SHIFT_DATE,'%d-%b-%y') AS SHIFT_DATE,
    dtl.CHILD_PRODUCT_CODE AS CHILD_PRODUCT_CODE,
    dtl.ISSUED_DATE As ISSUED_DATE,
    dtl.ISSUED_TIME As ISSUED_TIME,
    phdr.BOX_CODE As BOX_CODE,
    phdr.CREATED_DATETIME As CREATED_DATETIME,
    (case when (select sub_hdr.LINE_CODE from trace_child_part_hdr sub_hdr, trace_child_part_dtl sub_dtl where 
	sub_hdr.TRACE_CHILD_PART_HDR_ID = sub_dtl.TRACE_CHILD_PART_HDR_ID
    and sub_hdr.SERIAL_NUMBER = dtl.LOT_NUMBER limit 1) is null then 'L10000' else
    (select sub_hdr.LINE_CODE from trace_child_part_hdr sub_hdr, trace_child_part_dtl sub_dtl where 
	sub_hdr.TRACE_CHILD_PART_HDR_ID = sub_dtl.TRACE_CHILD_PART_HDR_ID
    and sub_hdr.SERIAL_NUMBER = dtl.LOT_NUMBER limit 1) end) AS SUB_LINE_CODE,
    (select sublms.LINE_MST_DESCRIPTION from trace_child_part_hdr sub_hdr, trace_child_part_dtl sub_dtl, line_mst sublms where 
	sub_hdr.TRACE_CHILD_PART_HDR_ID = sub_dtl.TRACE_CHILD_PART_HDR_ID
    and sub_hdr.LINE_CODE = sublms.LINE_MST_CODE
    and sub_hdr.SERIAL_NUMBER = dtl.LOT_NUMBER limit 1) AS SUB_LINE_DES,
    (select count(*) from trace_child_part_hdr sub_hdr, trace_child_part_dtl sub_dtl where 
	sub_hdr.TRACE_CHILD_PART_HDR_ID = sub_dtl.TRACE_CHILD_PART_HDR_ID
    and sub_hdr.SERIAL_NUMBER = dtl.LOT_NUMBER limit 1)  AS SUB_HDR_COUNT ,
    dtl.LOT_NUMBER AS LOT_NUMBER,
    dtl.STORAGE_UNIT_NUMBER AS STORAGE_UNIT_NUMBER,
    pm.PRODUCT_DESCRIPTION AS HDR_PRODUCT_DESCRIPTION,
    cm.PRODUCT_DESCRIPTION AS CHILD_PRODUCT_DESCRIPTION,
    smtype.SHIFT_MST_TYPE_DESCRIPTION AS SHIFT,
    lmst.LINE_MST_DESCRIPTION As LINE_MST_DESCRIPTION
FROM
    trace_child_part_hdr hdr
    left join product_packaging_dtl pdtl on hdr.SERIAL_NUMBER = pdtl.SERIAL_NO
    left join product_packaging_hdr phdr on phdr.PPH_ID = pdtl.PPH_ID
    inner join trace_child_part_dtl dtl on hdr.TRACE_CHILD_PART_HDR_ID = dtl.TRACE_CHILD_PART_HDR_ID
    inner join product_mst pm on hdr.PRODUCT_CODE = pm.PRODUCT_CODE
    inner join product_mst cm on dtl.CHILD_PRODUCT_CODE = cm.PRODUCT_CODE
    inner join shift_mst_hdr shdr on hdr.SHIFT = shdr.SHIFT_MST_HDR_ID
    inner join shift_mst_type_code smtype on shdr.SHIFT_MST_TYPE_CODE = smtype.SHIFT_MST_TYPE_CODE
    inner join line_mst lmst on hdr.LINE_CODE = lmst.LINE_MST_CODE
    
WHERE
        hdr.PRODUCT_CODE = pm.PRODUCT_CODE
        AND hdr.SERIAL_NUMBER = $P{SERIAL_NUMBER}
        AND hdr.LINE_CODE = $P{LINE_CODE}
        OR pdtl.SERIAL_NO = $P{SERIAL_NUMBER}
        AND hdr.TENANT_ID =  $P{TENANT_ID}
        AND phdr.IS_ACTIVE = '1'
        order by SUB_LINE_CODE]]>
	</queryString>
